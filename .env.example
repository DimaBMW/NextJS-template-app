# Read in app/config.ts. Defaults let the template run without a .env file.
NEXT_PUBLIC_SITE_NAME="Next.js App"
NEXT_PUBLIC_SITE_DESCRIPTION=""
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_LOCALE=ru-RU

# Set false for the published client site. Preview deployments stay noindex.
SITE_NOINDEX=true
